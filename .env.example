# Plantilla de variables de entorno. Copia este archivo a `.env.local` y rellena
# los valores reales. `.env.local` está ignorado por git; este `.env.example` sí
# se versiona, para dejar constancia de qué variables hacen falta.
#
# Los valores están en el panel de Supabase: Settings (engranaje) -> API.
#   VITE_SUPABASE_URL      = "Project URL"
#   VITE_SUPABASE_ANON_KEY = "Project API keys" -> la clave "anon" / "public"
#                            (en paneles nuevos aparece como "Publishable key",
#                            empieza por sb_publishable_...). Cualquiera sirve.
#   VITE_VAPID_PUBLIC_KEY  = la clave pública de `npx web-push generate-vapid-keys`.
#                            La privada va como secreto de Supabase
#                            (VAPID_PRIVATE_KEY), nunca en un archivo .env.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=
